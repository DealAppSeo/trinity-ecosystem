{
    "manifest_version": 3,
    "name": "GuardRail AI - Secure AI Wrapper",
    "version": "1.0.0",
    "description": "Enterprise-grade security for your AI agents. Protect against prompt injection, credential theft, and data exfiltration.",
    "permissions": [
        "activeTab",
        "storage",
        "webRequest",
        "scripting"
    ],
    "host_permissions": [
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "http://localhost:*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://chat.openai.com/*",
                "https://claude.ai/*",
                "https://gemini.google.com/*",
                "http://localhost:*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/shield-16.png",
            "48": "icons/shield-48.png",
            "128": "icons/shield-128.png"
        }
    },
    "icons": {
        "16": "icons/shield-16.png",
        "48": "icons/shield-48.png",
        "128": "icons/shield-128.png"
    }
}
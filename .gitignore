# ─────────────────────────────────────────────────────────────────────────────
# Added 2026-08-04. This repo had NO .gitignore, which is why the deploy broke.
#
# `.next/` — the Next.js BUILD OUTPUT — was committed (65 files). A committed
# build directory ships a stale Server Action manifest, and Next resolves
# incoming action ids against it. That is the direct cause of the runtime flood:
#
#     Error: Failed to find Server Action "6607bb17".
#     This request might be from an older or newer deployment.
#
# The message is accurate and was pointing at the repo the whole time: the
# deployment really did contain actions from an older build, because the older
# build was checked in. Never commit .next/.
# ─────────────────────────────────────────────────────────────────────────────

# Build output
.next/
out/
build/
dist/
*.tsbuildinfo

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment — .env and .env.local were TRACKED here. Both are empty at HEAD,
# but history at 5523937d (2026-04-17) carried a real TELEGRAM_BOT_TOKEN.
# Untracking is not rotation: that token is still in git history and should be
# rotated regardless of this file.
.env
.env*.local
.env.production
!.env.example

# Agent/tool scratch. A committed .claude/worktrees tree (including a nested
# copy of another repo) previously bloated the build context to 61.7 MB and made
# railpack discover phantom package.json files outside the project root.
.claude/worktrees/
.claude/settings.local.json

# Logs / OS / editor
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/

# Vercel / coverage
.vercel
coverage/

# Stale audit dump: contained a complete devnet Solana secret key and local
# filesystem paths. Regenerate locally if needed; never commit it.
audit_output.txt

# ─────────────────────────────────────────────────────────────────────────────
# Graphify knowledge-graph output. Deliberately NOT committed.
#
# graph.json is a derived index of the code. Committing it repeats the exact
# mistake the top of this file documents: a checked-in build artefact goes
# stale against the source it describes, and here the failure is quieter than
# the .next/ one — an agent queries the graph, gets a confident answer about
# code that no longer exists, and never sees an error. Rebuild instead:
# `npm run graph` takes seconds and needs no LLM.
# ─────────────────────────────────────────────────────────────────────────────
graphify-out/
headroom.db

# temp compile dir for check:identity
.identity-check-*/
.work-contract-check-*/
.contracted-eval-check-*/
.outcome-rep-check-*/
.auditor-grant-check-*/
.bft-judge-check-*/
.handoff-check-*/
.did-compare-check-*/
.repid-scoring-check-*/
.hal-chain-check-*/
.receipt-audit-check-*/

# temp compile dir for check:custody-shadow
.custody-shadow-check-*/

# agent-browser runtime output (screenshots, HAR, traces, video). Derived
# artefacts of a dev tool; the daemon writes here because ./agent-browser.json
# sets screenshotDir. Machine-local config lives in ~/.agent-browser/, not here.
.agent-browser/

# TrustShell Stop-hook output (§7.3 — redirected so a crash cannot reach the session)
.trustshell.log

# Compiled output emitted next to TypeScript sources. lib/ is source-only: every
# check script compiles to a temp dir. A stale .js beside its .ts drifts from
# source silently and some resolvers prefer it. Committed once in e44c9f0 by a
# `git add -A` after a tsc run that lacked --noEmit.
lib/**/*.js
!lib/**/*.config.js

# scan-secrets.mjs --state cache: per-commit history results, carried between CI
# runs so the scan searches only new commits. Holds fingerprints (truncated
# prefixes), never a whole credential — but it is machine state, not source, and
# leaving it untracked would put it in the scanner's own working-tree pass.
.secret-history-state.json

# scan-secrets.mjs --state cache: per-commit history results, carried between CI
# runs so the scan searches only new commits. Holds fingerprints (truncated
# prefixes), never a whole credential — but it is machine state, not source.
#
# UNTRACKED AS WELL AS IGNORED, 2026-08-15. It arrived tracked via PR #47 at
# 2.9 MB and a .gitignore entry alone would not have untracked it — ignore rules
# do not apply to files already in the index. Measured cost of untracking:
# a cache miss scans cold in 44.8s instead of 0.25s, producing identical
# findings. CI caches it independently (actions/cache restore/save in
# check.yml), so the tracked copy bought nothing there and cost a new 2.9 MB
# blob in history every time a run updated it, across every parallel lane.
.secret-history-state.json

# Scratch dirs written INTO the repo by check suites (mkdtemp + random suffix).
# Two had already been committed when this block was added on 2026-08-17:
# .durable-ledger-check-JH8rRL/ and .zk-cost-check-SZFzbE/. Enforced by
# check:tmpdir-ignored, which also fails if one is TRACKED — an entry here does
# not untrack what is already in the index.
.assigned-contract-check-*/
.auth-session-check-*/
.checker-assign-check-*/
.claims-check-*/
.config-readiness-check-*/
.criteria-draw-check-*/
.dogfood-*/
.durable-ledger-check-*/
.envelope-check-*/
.hal-accuracy-check-*/
.hal-receipt-check-*/
.hal-repid-linkage-check-*/
.loud-errors-check-*/
.m3-check-*/
.receipt-check-*/
.floor-decay-check-*/
.receipt-cli-*/
.repid-calibration-check-*/
.verdict-provenance-check-*/
.mutate.lock
.repid-drift-check-*/
.repid-marginal-check-*/
.spine-e2e-check-*/
.trust-harness-fixture-*/
.spine-reachable-check-*/
.staged-judge-check-*/
.throughput-check-*/
.zk-cost-check-*/
.poseidon2-check-*/
.harness-extract-check-*/
.repid-weight-sim-*/
.issuer-stake-check-*/
.proof-contract-check-*/
.ratchet-decay-check-*/

# Scratch dirs written by check scripts into the repo root. The suffix is
# random per run (mkdtempSync), so these MUST be globs — see
# `npm run check:tmpdir-ignored`, which fails the build when one is missing.
.alert-digest-check-*/
.open-index-check-*/
.open-work-check-*/

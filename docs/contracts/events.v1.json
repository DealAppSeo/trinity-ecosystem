{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://repid.dev/schemas/events.v1.json",
  "title": "RepID Score Events and ERC-8004 Passport Contracts",
  "description": "Strict, production-grade schemas for RepID ledger score events, selective-disclosure passport disclosures, and x402 spending gate contracts.",
  "x-provenance": {
    "status": "AUTHORITATIVE",
    "authored_by": "GA (Gemini Agent / authoritative lane), 2026-08-19",
    "why": [
      "Replacing the CC stand-in reconstruction with the authoritative, production-grade schemas.",
      "The stand-in files were conceptual math reconstructions, whereas our authoritative versions are the exact production-ready draft-07 schemas.",
      "These match the actual database schema for RepID score events (DORMANCY_DECAY, ECOSYSTEM_REFERRAL, IMPACT_REWARD) and passport/spending gate contracts (ZKPPassportDisclosure, X402GateDecision)."
    ],
    "reconciled": {
      "on": "2026-08-19",
      "against": "main @ 39670f4 (#108, integer-delta is ledger law)",
      "why": "GA's branch forked before events.v1.json existed on main (base 648c6f4) and independently reconstructed the file, typing delta/repid_delta_applied as number. Main's #108 had since typed them integer, with docs/policy/integer-delta-rule.v1.md as the rule and a Mutant contract-delta-accepts-float regression test guarding it. This reconciliation keeps every GA addition (this provenance block, x-open-blockers, the idempotency-key clock-skew descriptions, the referral/impact minimum:1 tightening) and restores the integer typing so neither lane's work is lost or silently regressed. Landed on a fresh branch, not on claude/ga-contracts-v1 and not on main -- see docs/contracts/CONSUMER.md and the branch's own commit message for the full diff."
    }
  },
  "x-open-blockers": {
    "agent_id_vs_did_mapping": {
      "status": "OPEN",
      "severity": "CRITICAL",
      "description": "The ledger event and scoring schemas use strict UUID foreign keys pointing to repid_agents(id). Signed verdicts, however, carry Decentralized Identifiers (DIDs, did:key:...). Currently, there is 0 active database mapping from DID to repid_agents.id (identity_claims and sandbox_repid_credentials are both 0 rows). This is an open blocker for live-verdict ledger resolution.",
      "remediation_plan": "A separate translation module or oracle must populate identity_claims before on-chain write lanes or routing engines can map did-named signatures to database-assigned UUIDs."
    }
  },
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "repid_range": {
      "type": "integer",
      "minimum": 10,
      "maximum": 10000
    },
    "applied_delta": {
      "type": "integer",
      "description": "Ledger-applied delta. JSON number with a fractional part is invalid. See docs/policy/integer-delta-rule.v1.md. Non-applied fields (weeks_idle, effective_rate, I, delta_raw) may be number."
    },
    "DORMANCY_DECAY": {
      "type": "object",
      "required": [
        "agent_id",
        "event_type",
        "delta",
        "repid_before",
        "repid_after",
        "repid_delta_applied",
        "idempotency_key",
        "metadata"
      ],
      "properties": {
        "agent_id": { "$ref": "#/definitions/uuid" },
        "event_type": { "type": "string", "enum": ["DORMANCY_DECAY"] },
        "delta": { "type": "integer", "maximum": 0 },
        "repid_before": { "$ref": "#/definitions/repid_range" },
        "repid_after": { "$ref": "#/definitions/repid_range" },
        "repid_delta_applied": { "type": "integer", "maximum": 0 },
        "idempotency_key": {
          "type": "string",
          "pattern": "^decay:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}:[0-9]{4}-[0-9]{2}-[0-9]{2}:tick_[0-9]+_of_[0-9]+$",
          "description": "Unique key ensuring idempotency under clock skew and retries. Format: 'decay:<agent_id_uuid>:<utc_decay_week_start_date>:tick_<k>_of_<K>'. The date parameter MUST represent the deterministic UTC week-start date (typically a Monday) of the decay run epoch to remain perfectly immune to local system clock skew or drift at runtime.",
          "comment": "CLOCK_SKEW_IMMUNE: Generated deterministically on week boundary."
        },
        "metadata": {
          "type": "object",
          "required": [
            "reason",
            "weeks_idle",
            "effective_rate",
            "floored",
            "is_decay_shock",
            "shock_k_of_n",
            "shock_epoch"
          ],
          "properties": {
            "reason": { "type": "string", "enum": ["Dormancy decay"] },
            "weeks_idle": { "type": "number", "minimum": 0 },
            "effective_rate": { "type": "number", "minimum": 0 },
            "floored": { "type": "boolean" },
            "is_decay_shock": { "type": "boolean" },
            "shock_k_of_n": { "type": "string", "pattern": "^[0-9]+ of [0-9]+$" },
            "shock_epoch": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "ECOSYSTEM_REFERRAL": {
      "type": "object",
      "required": [
        "agent_id",
        "event_type",
        "delta",
        "repid_before",
        "repid_after",
        "repid_delta_applied",
        "idempotency_key",
        "metadata"
      ],
      "properties": {
        "agent_id": { "$ref": "#/definitions/uuid" },
        "event_type": { "type": "string", "enum": ["ECOSYSTEM_REFERRAL"] },
        "delta": { "type": "integer", "minimum": 1 },
        "repid_before": { "$ref": "#/definitions/repid_range" },
        "repid_after": { "$ref": "#/definitions/repid_range" },
        "repid_delta_applied": { "type": "integer", "minimum": 1 },
        "idempotency_key": {
          "type": "string",
          "pattern": "^referral:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "description": "Unique key ensuring idempotency. Format: 'referral:<deterministic_v5_uuid>'. The UUID MUST be generated using RFC 4122 namespace v5 over the deterministic tuple (referrer_id, referee_id, referral_index) to guarantee identical output on caller retry, bypassing client clock-skew.",
          "comment": "CLOCK_SKEW_IMMUNE: Deterministic UUIDv5."
        },
        "metadata": {
          "type": "object",
          "required": ["referred_agent_id", "referral_index", "base_reward", "decay_curve"],
          "properties": {
            "referred_agent_id": { "$ref": "#/definitions/uuid" },
            "referral_index": { "type": "integer", "minimum": 1 },
            "base_reward": { "type": "number", "minimum": 0 },
            "decay_curve": { "type": "string", "enum": ["logarithmic"] }
          }
        }
      }
    },
    "IMPACT_REWARD": {
      "type": "object",
      "required": [
        "agent_id",
        "event_type",
        "delta",
        "repid_before",
        "repid_after",
        "repid_delta_applied",
        "idempotency_key",
        "metadata"
      ],
      "properties": {
        "agent_id": { "$ref": "#/definitions/uuid" },
        "event_type": { "type": "string", "enum": ["IMPACT_REWARD"] },
        "delta": { "type": "integer", "minimum": 1 },
        "repid_before": { "$ref": "#/definitions/repid_range" },
        "repid_after": { "$ref": "#/definitions/repid_range" },
        "repid_delta_applied": { "type": "integer", "minimum": 1 },
        "idempotency_key": {
          "type": "string",
          "pattern": "^impact:[a-zA-Z0-9_-]+:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "description": "Unique key ensuring idempotency. Format: 'impact:<action_class_slug>:<deterministic_v5_uuid>'. The UUID MUST be generated using RFC 4122 namespace v5 over the payload tuple (action_class, severity_multiplier, base_value, reviewer_id) to ensure zero duplicate writes even under clock drift or late network retries.",
          "comment": "CLOCK_SKEW_IMMUNE: Deterministic UUIDv5."
        },
        "metadata": {
          "type": "object",
          "required": ["action_class", "severity_multiplier", "base_value", "reviewer_id"],
          "properties": {
            "action_class": {
              "type": "string",
              "enum": ["bug_bounty_critical", "ecosystem_tooling", "governance_vote"]
            },
            "severity_multiplier": { "type": "number", "minimum": 1.0 },
            "base_value": { "type": "number", "minimum": 0 },
            "reviewer_id": { "$ref": "#/definitions/uuid" }
          }
        }
      }
    },
    "ZKPPassportDisclosure": {
      "type": "object",
      "required": [
        "current_repid",
        "tier",
        "axis_scores",
        "verification_axis"
      ],
      "properties": {
        "current_repid": { "$ref": "#/definitions/repid_range" },
        "tier": {
          "type": "string",
          "enum": ["PROBATIONARY", "EARNING", "ESTABLISHED", "AUTONOMOUS", "VETERAN"]
        },
        "axis_scores": {
          "type": "object",
          "required": ["reliability", "accuracy", "alignment", "impact", "longevity"],
          "properties": {
            "reliability": { "type": "number", "minimum": 0, "maximum": 100 },
            "accuracy": { "type": "number", "minimum": 0, "maximum": 100 },
            "alignment": { "type": "number", "minimum": 0, "maximum": 100 },
            "impact": { "type": "number", "minimum": 0, "maximum": 100 },
            "longevity": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "verification_axis": {
          "type": "object",
          "required": ["soft_landing_active", "amortization_progress", "bft_mismatch_observed"],
          "properties": {
            "soft_landing_active": { "type": "boolean" },
            "amortization_progress": {
              "type": ["string", "null"],
              "pattern": "^[0-9]+ of [0-9]+$"
            },
            "bft_mismatch_observed": { "type": "boolean" }
          }
        }
      }
    },
    "X402GateDecision": {
      "type": "object",
      "required": [
        "agent_id",
        "requested_usd",
        "effective_authority",
        "real_collateral_usd",
        "decision",
        "warning"
      ],
      "properties": {
        "agent_id": { "$ref": "#/definitions/uuid" },
        "requested_usd": { "type": "number", "minimum": 0 },
        "effective_authority": { "type": "number", "minimum": 0 },
        "real_collateral_usd": { "type": "number", "minimum": 0 },
        "decision": {
          "type": "string",
          "enum": ["APPROVED", "DENIED_AUTHORITY_EXCEEDED", "DENIED_NO_STAKE"]
        },
        "warning": {
          "type": ["string", "null"],
          "enum": ["SOFT_LANDING_ACTIVE_AUTHORITY_WILL_DECAY", null]
        }
      }
    }
  },
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/DORMANCY_DECAY" },
    { "$ref": "#/definitions/ECOSYSTEM_REFERRAL" },
    { "$ref": "#/definitions/IMPACT_REWARD" }
  ]
}
